DEFINE SCHEMA

    RECORD TYPE CD_CrateItem (
        CD_addedAt                 TIMESTAMP QUERYABLE SORTABLE,
        CD_albumTitle              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_artistName              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_artworkURLString        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_broadcastOffsetSeconds  DOUBLE QUERYABLE SORTABLE,
        CD_embedProviderRaw        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_genreTagsRaw            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_identificationStatusRaw STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isLiveStream            INT64 QUERYABLE SORTABLE,
        CD_kindRaw                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_matchKey                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_playbackURLString       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_providerID              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_showID                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_showSubtitle            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_showTitle               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_stationName             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_unknownCode             STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"            TIMESTAMP,
        "___createdBy"             REFERENCE,
        "___etag"                  STRING,
        "___modTime"               TIMESTAMP,
        "___modifiedBy"            REFERENCE,
        "___recordID"              REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_DigCounter (
        CD_count        INT64 QUERYABLE SORTABLE,
        CD_deviceID     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_firstAt      TIMESTAMP QUERYABLE SORTABLE,
        CD_id           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_key          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_kindRaw      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_lastAt       TIMESTAMP QUERYABLE SORTABLE,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_DigStep (
        CD_count        INT64 QUERYABLE SORTABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fromNodeID   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_identity     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_lastAt       TIMESTAMP QUERYABLE SORTABLE,
        CD_toNodeID     STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_DigVisit (
        CD_discogsID      INT64 QUERYABLE SORTABLE,
        CD_entityName     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_firstVisitedAt TIMESTAMP QUERYABLE SORTABLE,
        CD_handle         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_kindRaw        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_lastVisitedAt  TIMESTAMP QUERYABLE SORTABLE,
        CD_mbid           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_nodeID         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_providerID     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_subtitle       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_visits         INT64 QUERYABLE SORTABLE,
        "___createTime"   TIMESTAMP,
        "___createdBy"    REFERENCE,
        "___etag"         STRING,
        "___modTime"      TIMESTAMP,
        "___modifiedBy"   REFERENCE,
        "___recordID"     REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ListeningEvent (
        CD_actionRaw        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_at               TIMESTAMP QUERYABLE SORTABLE,
        CD_completion       DOUBLE QUERYABLE SORTABLE,
        CD_discogsID        INT64 QUERYABLE SORTABLE,
        CD_entityName       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_handle           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_mbid             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_nodeID           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_nodeKey          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_nodeKindRaw      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_providerID       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_seconds          DOUBLE QUERYABLE SORTABLE,
        CD_sourceProviderID STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceShowID     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceShowTitle  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_subtitle         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_tags             BYTES QUERYABLE SORTABLE,
        CD_title            STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"     TIMESTAMP,
        "___createdBy"      REFERENCE,
        "___etag"           STRING,
        "___modTime"        TIMESTAMP,
        "___modifiedBy"     REFERENCE,
        "___recordID"       REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
